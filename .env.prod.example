# Copy this to .env on the Oracle Cloud VM and fill in all values.
# Replace ORACLE_IP with your actual instance public IP.

# --- Domain (used by Caddy for SSL + CORS) ---
DOMAIN=ORACLE_IP.nip.io

# --- LLM (Claude) ---
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# --- NVIDIA OCR ---
NVIDIA_API_KEY=
NVIDIA_OCR_MODEL=baidu/paddleocr

# --- OpenAI OCR (optional) ---
OPENAI_API_KEY=

# --- Google (Drive + Sheets) ---
# Update redirect URI to match your domain
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://ORACLE_IP.nip.io/api/google/callback

# --- Server ---
PORT=8000
WEB_ORIGIN=https://ORACLE_IP.nip.io

# --- Security ---
# Generate with: openssl rand -hex 32
API_KEY=
